# App
BETTER_AUTH_SECRET=generate_a_long_random_string_at_least_32_chars
# Fallback canónico (también sirve si no hay Host en alguna llamada server-side)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Hosts extra permitidos (coma-separados), p.ej. IP fija de la clínica en prod:
# AUTH_ALLOWED_HOSTS=clinica.local:3000,203.0.113.10:3000

# Dictado Fase 4 (opcional). Sin clave: extractor rule-based + texto/voz del navegador.
# OPENAI_API_KEY=
# STT_API_KEY=
# STT_MODEL=whisper-1
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_EXTRACTOR=rule-based

# Postgres (Docker)
POSTGRES_PORT=5432
POSTGRES_MIGRATOR_PASSWORD=migrator_dev_only
POSTGRES_APP_PASSWORD=app_user_dev_only

# Migrator connection (drizzle-kit / migrations / seed setup)
DATABASE_URL=postgresql://migrator:migrator_dev_only@localhost:5432/clinica

# App runtime connection (NEVER the table owner)
DATABASE_APP_URL=postgresql://app_user:app_user_dev_only@localhost:5432/clinica
